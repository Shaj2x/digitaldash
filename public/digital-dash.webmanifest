{
  "name": "Digital Dash",
  "short_name": "Dash",
  "description": "A study dashboard: focus timers, tasks, courses and grades, calendar and reminders.",
  "id": "/digital-dash.html",
  "start_url": "/digital-dash.html",
  "scope": "/digital-dash",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#141220",
  "theme_color": "#141220",
  "icons": [
    {
      "src": "/digital-dash-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/digital-dash-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/digital-dash-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New task",
      "short_name": "New task",
      "description": "Add a task",
      "url": "/digital-dash.html#new-task",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start focus",
      "short_name": "Focus",
      "description": "Start a focus timer",
      "url": "/digital-dash.html#start-focus",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Today",
      "short_name": "Today",
      "description": "What's due today",
      "url": "/digital-dash.html#today",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "url": "/digital-dash.html#calendar",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
