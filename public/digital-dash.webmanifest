{
  "name": "Digital Dash",
  "short_name": "Dash",
  "description": "A study dashboard: focus timers, tasks, courses and grades, calendar and reminders.",
  "id": "/digital-dash",
  "start_url": "/digital-dash",
  "scope": "/digital-dash",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#1B1B1B",
  "theme_color": "#1B1B1B",
  "icons": [
    {
      "src": "/digital-dash-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/digital-dash-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/digital-dash-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New task",
      "short_name": "New task",
      "description": "Add a task",
      "url": "/digital-dash#new-task",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start focus",
      "short_name": "Focus",
      "description": "Start a focus timer",
      "url": "/digital-dash#start-focus",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Today",
      "short_name": "Today",
      "description": "What's due today",
      "url": "/digital-dash#today",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Week plan",
      "short_name": "Week",
      "description": "Plan your week day by day",
      "url": "/digital-dash#plan",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "url": "/digital-dash#calendar",
      "icons": [
        {
          "src": "/digital-dash-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
